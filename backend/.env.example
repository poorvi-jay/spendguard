# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Where PayPal should send the buyer back after approving in the sandbox UI
PAYPAL_RETURN_URL=http://localhost:8000/checkout/return
PAYPAL_CANCEL_URL=http://localhost:8000/checkout/cancel

# LLM used for the intent-match check. Any OpenAI-compatible chat completions API works.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Local SQLite file
DB_PATH=./spendguard.db

# Shared secret for the hosted /mcp endpoint. Leave empty for local dev only.
MCP_AUTH_TOKEN=
